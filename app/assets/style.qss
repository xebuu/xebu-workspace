/* XebuWorkspace visual system.
   Tokens are replaced by MainWindow.apply_style(). */

QMainWindow,
QDialog,
QStackedWidget {
    background: @app_background@;
}

QWidget {
    color: @text_primary@;
    font-size: 12px;
}

QStatusBar,
QMenuBar,
QMenu {
    background: @surface_sunken@;
    color: @text_secondary@;
    border: none;
}

QMenu::item:selected {
    background: @surface_hover@;
}

QToolBar {
    background: @surface_sunken@;
    border: none;
    border-bottom: 1px solid @border_subtle@;
    spacing: 6px;
    padding: 6px;
}

QLabel {
    color: @text_primary@;
    font-weight: 600;
}

QLabel#Title {
    color: @text_primary@;
    font-size: 22px;
    font-weight: 800;
}

QLabel#RunTitle,
QLabel#SectionHeader,
QLabel#SectionHeading,
QLabel#ColTitle {
    color: @text_primary@;
    font-size: 16px;
    font-weight: 800;
}

QLabel#CardTitle {
    color: @text_primary@;
    font-size: 15px;
    font-weight: 800;
}

QLabel#CardMeta,
QLabel#SectionHint,
QLabel#HintLabel {
    color: @text_muted@;
    font-size: 12px;
}

QPushButton,
QToolButton {
    background: @surface_raised@;
    color: @text_primary@;
    border: 1px solid @border_normal@;
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: 700;
    text-align: center;
}

QPushButton:hover,
QToolButton:hover {
    background: @surface_hover@;
    border-color: @border_strong@;
}

QPushButton:pressed,
QToolButton:pressed,
QPushButton:checked,
QToolButton:checked {
    background: @accent_muted@;
    border-color: @accent_normal@;
    color: @text_primary@;
}

QPushButton#SaveBtn,
QPushButton#AccentPickerBtn,
QPushButton#Open,
QPushButton#Run {
    background: @accent_normal@;
    color: @accent_text@;
    border-color: @accent_checked@;
}

QPushButton#SaveBtn:hover,
QPushButton#AccentPickerBtn:hover,
QPushButton#Open:hover,
QPushButton#Run:hover {
    background: @accent_hover@;
}

QPushButton#Delete,
QPushButton#BtnDel {
    background: @state_danger@;
    color: #ffffff;
    border-color: @state_danger@;
}

QPushButton#BtnOk {
    background: @state_success@;
    color: @text_inverse@;
    border-color: @state_success@;
}

QPushButton#BtnArc {
    background: @state_info@;
    color: @text_inverse@;
    border-color: @state_info@;
}

QLineEdit,
QTextEdit,
QDateEdit,
QComboBox,
QListWidget {
    background: @surface_sunken@;
    color: @text_primary@;
    border: 1px solid @border_normal@;
    border-radius: 8px;
    padding: 7px 10px;
    selection-background-color: @accent_muted@;
    selection-color: @text_primary@;
}

QLineEdit:hover,
QTextEdit:hover,
QDateEdit:hover,
QComboBox:hover {
    border-color: @border_strong@;
}

QLineEdit:focus,
QTextEdit:focus,
QDateEdit:focus,
QComboBox:focus {
    border-color: @accent_normal@;
    background: @surface_base@;
}

QCheckBox {
    color: @text_secondary@;
    spacing: 8px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: @surface_sunken@;
    border: none;
    margin: 0px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: @border_strong@;
    border-radius: 4px;
    min-height: 28px;
    min-width: 28px;
}

QScrollBar::handle:hover {
    background: @accent_muted@;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}

/* Sidebar */

QFrame#OverlaySidebar {
    background: @surface_sunken@;
    border-right: 1px solid @border_subtle@;
}

QPushButton#SidebarButton {
    background: transparent;
    color: @text_muted@;
    border: 1px solid transparent;
    border-radius: 8px;
}

QPushButton#SidebarButton:hover {
    background: @surface_hover@;
    color: @text_primary@;
}

QPushButton#SidebarButton[selected="true"] {
    background: @accent_muted@;
    color: @text_primary@;
    border-color: @accent_normal@;
}

/* Cards and panels */

QFrame#Card,
QFrame#DashboardSection,
QFrame#CalendarMonthFrame,
QFrame#CalendarAgendaFrame,
QFrame#NotificationSection,
QFrame#AppearanceFrame,
QFrame#UserDataFrame,
QFrame#TaskContainer,
QFrame#DescContainer,
QFrame#CosmeticFrame {
    background: @surface_base@;
    border: 1px solid @border_subtle@;
    border-radius: 8px;
}

QFrame#Card:hover {
    background: @surface_hover@;
    border-color: @accent_muted@;
}

QFrame#DashboardTaskRow,
QFrame#TaskRow,
QFrame#TaskRowMini,
QFrame#TaskItemFrame {
    background: @surface_raised@;
    border: 1px solid @border_subtle@;
    border-radius: 8px;
}

QFrame#DashboardTaskRow:hover,
QFrame#TaskRow:hover,
QFrame#TaskRowMini:hover,
QFrame#TaskItemFrame:hover {
    border-color: @accent_muted@;
}

QFrame#QuickAddFrame {
    background: @surface_raised@;
    border: 1px solid @accent_muted@;
    border-radius: 8px;
}

QLabel#TaskLabel {
    color: @text_primary@;
}

/* Calendar */

QFrame#CalendarDayCell {
    background: @surface_base@;
    border: 1px solid @border_subtle@;
    border-radius: 8px;
}

QLabel#CalendarChip {
    background: @calendar_chip_bg@;
    color: @text_primary@;
    border-radius: 5px;
    padding: 3px 5px;
    font-size: 11px;
}

QFrame#AddTaskButtonFrame {
    border: 1px dashed @border_strong@;
    background: transparent;
    border-radius: 8px;
}

QFrame#AddTaskButtonFrame:hover {
    background: @surface_hover@;
    border-color: @accent_normal@;
}

/* Configuracion */

QToolButton#ThemeDot {
    border-radius: 19px;
    border: 2px solid @border_strong@;
}

QToolButton#ThemeDot:hover {
    border-color: @text_primary@;
}

QToolButton#ThemeDot:checked {
    border: 3px solid @text_primary@;
}

QFrame#AccentSwatch {
    border: 1px solid @border_strong@;
    border-radius: 6px;
}

QPushButton#UserDataBtn {
    background: @surface_raised@;
    color: @text_secondary@;
    border-color: @border_normal@;
    text-align: left;
}

QPushButton#UserDataBtn:hover {
    background: @surface_hover@;
    color: @text_primary@;
}

QPushButton#DeleteDataBtn {
    background: @surface_raised@;
    color: @state_danger@;
    border-color: @state_danger@;
    text-align: left;
}

QPushButton#DeleteDataBtn:hover {
    background: @state_danger@;
    color: #ffffff;
}

/* Project viewer */

QWidget#ProjectViewerBackground {
    background: @app_background@;
}

QToolBar#ProjectViewerToolbar {
    background: @surface_sunken@;
    border-bottom: 1px solid @border_subtle@;
}
