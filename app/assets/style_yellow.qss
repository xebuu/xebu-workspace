/* ===========================
   GENERAL BUTTONS
=========================== */

QPushButton {
    color: #fff;
    background: #2d2d2d;
    border: 0.5px;
    padding: 8px 10px;
    border-radius: 8px;
    text-align: left;
    font-weight: bold;
    font-size: 12px;
}

QPushButton:hover {
    background: #565555;
}

QPushButton:checked {
    background: #383838;
}


/* ===========================
   TOGGLE BUTTON
=========================== */

#ToggleBtn {
    font-weight: bold;
    background: #2d2d2d;
    color: #fff;
}


/* ===========================
   STATUS BAR
=========================== */

QStatusBar {
    background: #2d2d2d;
    color: #374151;
}


/* ===========================
   STACKED WIDGET
=========================== */

QStackedWidget {
    background: #2d2d2d;
}


/* ===========================
   SIDEBAR
=========================== */

#SideBar {
    background: #565555;
    border-right: 8px solid #EFEDE1;
}


/* ===========================
   TITLES & LABELS
=========================== */

QLabel#Title {
    color: #EFEDE1;
    font-size: 20px;
    font-weight: 800;
}

QLabel#CardTitle {
    color: #EFEDE1;
    font-size: 15px;
    font-weight: 700;
}

QLabel#CardMeta {
    color: #bfc8c8;
    font-size: 12px;
}

QLabel#RunTitle {
    color: #EFEDE1;
    font-size: 18px;
    font-weight: 800;
}

QLabel {
    color: #EFEDE1;
    font-weight: 600;
}


/* ===========================
   CARD FRAMES
=========================== */

QFrame#Card {
    background: #4a3d24;                /* dorado oscuro */
    border: 1px solid #4a3d24;
    border-radius: 12px;
}

QFrame#Card:hover {
    background: #5c4a29;                /* tono más claro al hover */
    border: 1px solid #5c4a29;
}


/* ===========================
   SPECIAL BUTTONS
=========================== */

QPushButton#Open {
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: 600;
    background: #4a3d24;
    color: white;
    border: 1px solid #4a3d24;
}

QPushButton#Open:hover {
    background: #facc15;                /* amarillo intenso */
    color: #1a1a1a;
}

QPushButton#Edit {
    background: #4a3d24;
    color: #f3f4f6;
    border: 1px solid #4a3d24;
}

QPushButton#Edit:hover {
    background: #fbbf24;                /* amarillo cálido */
    color: #1a1a1a;
}

QPushButton#Delete {
    background: #4a3d24;
    color: white;
    border: 1px solid #4a3d24;
}

QPushButton#Delete:hover {
    background: #ff4e4e;
}

QPushButton#Run {
    background: #facc15;                /* dorado primario */
    color: #1a1a1a;
    border: 1px solid #eab308;
}

QPushButton#Run:hover {
    background: #eab308;
}


/* ===========================
   DIALOGS & INPUTS
=========================== */

QDialog {
    background: #1b2224;
}

QLineEdit,
QTextEdit,
QListWidget {
    background: #2b2417;                /* fondo amarillento oscuro */
    color: #EFEDE1;
    border: 1px solid #4a3d24;
    border-radius: 8px;
    padding: 6px 8px;
}

QListWidget::item:selected {
    background: #5c4a29;
    border-radius: 6px;
}

QListWidget::item:hover {
    background: #735a34;
    border-radius: 6px;
}

QTextEdit {
    background: #2b2417;
    color: #EFEDE1;
    border: 1px solid #4a3d24;
    border-radius: 8px;
    padding: 8px;
}
